{
  "name": "cloud-engineering-academy",
  "version": "9.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "node --test tests/*.test.mjs",
    "test:bdd": "node --test tests/bdd-*.test.mjs",
    "lint": "biome ci src tests scripts",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "security:test": "node --test tests/security-v5.test.mjs",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "sbom:check": "node scripts/check-sbom.mjs",
    "security:sca": "node scripts/check-sca-audit.mjs",
    "verify": "npm run verify:offline && npm run typecheck && npm run lint && npm run format:check && npm run build && npm run bundle:budget",
    "test:e2e": "playwright test --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "security:scan": "node scripts/check-secrets.mjs",
    "integrity": "node scripts/verify-integrity.mjs",
    "manifest:update": "node scripts/update-manifest.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "verify:source": "node scripts/check-release-source.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "syntax": "node scripts/check-typescript-syntax.mjs",
    "verify:offline": "npm run verify:source && npm run syntax && npm test && npm run integrity && npm run security:scan && npm run security:audit",
    "verify:release": "npm run doctor && npm run verify && npm run sbom:check && npm audit --omit=dev --audit-level=high && npm run security:sca && npm run test:e2e",
    "doctor": "node scripts/project-doctor.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.2.1",
    "lucide-preact": "^0.468.0",
    "preact": "^10.27.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.2.4",
    "@playwright/test": "^1.56.0",
    "@preact/preset-vite": "^2.10.2",
    "@types/three": "^0.187.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
